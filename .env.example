# ── LLM 提供商配置（切换模型只需修改这三行）────────────────────────
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 其他兼容 OpenAI 格式的提供商示例：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
#
# LLM_BASE_URL=http://localhost:11434/v1   # 本地 Ollama
# LLM_MODEL=qwen2.5:14b

# ── 气象文件路径（指向容器内 /app/weather/ 挂载目录）───────────────
# 将 EPW 文件放入宿主机 ./weather/ 目录，然后在此指定路径
SESSION_EPW_PATH=/app/weather/Shenzhen.epw
# SESSION_EPW_PATH=/app/weather/Beijing.epw
# SESSION_EPW_PATH=/app/weather/Shanghai.epw
