# 配置文件（含敏感信息，如 API Key、本地路径）
configs/config.yaml

# 运行时生成的输出文件
logs/
output/

# Go 编译产物
*.exe
*.test
/EPlus-Agent

# 文档目录
docs/

# Claude 本地配置
.claude/

# RAG 向量索引文件（体积大，由 build_rag_index.py 生成）
data/index/*.idx

# Docker 环境变量（含 API Key，勿提交）
.env

# pytools 运行时产物
pytools/.venv/
pytools/data/dependencies/    # Energy+.idd 体积大，运行时从镜像内复制
pytools/__pycache__/
pytools/src/**/__pycache__/
pytools/output/

# 气象文件目录（用户自行放置，不纳入版本控制）
weather/

# 系统文件
.DS_Store
Thumbs.db
